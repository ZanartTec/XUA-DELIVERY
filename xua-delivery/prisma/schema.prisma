generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums PostgreSQL (seção 2.3) ──────────────────────────────

enum DeliveryWindow {
  MORNING    @map("morning")
  AFTERNOON  @map("afternoon")

  @@map("delivery_window")
}

enum OrderStatus {
  DRAFT
  CREATED
  PAYMENT_PENDING
  CONFIRMED
  SENT_TO_DISTRIBUTOR
  ACCEPTED_BY_DISTRIBUTOR
  REJECTED_BY_DISTRIBUTOR
  PICKING
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  REDELIVERY_SCHEDULED
  CANCELLED

  @@map("order_status")
}

enum OtpStatus {
  ACTIVE   @map("active")
  USED     @map("used")
  EXPIRED  @map("expired")
  LOCKED   @map("locked")

  @@map("otp_status")
}

enum PaymentKind {
  ORDER         @map("order")
  SUBSCRIPTION  @map("subscription")
  DEPOSIT       @map("deposit")

  @@map("payment_kind")
}

enum PaymentStatus {
  CREATED     @map("created")
  AUTHORIZED  @map("authorized")
  CAPTURED    @map("captured")
  FAILED      @map("failed")
  REFUNDED    @map("refunded")
  EXPIRED     @map("expired")

  @@map("payment_status")
}

enum DepositStatus {
  HELD              @map("held")
  REFUND_INITIATED  @map("refund_initiated")
  REFUNDED          @map("refunded")
  FORFEITED         @map("forfeited")
  CANCELLED         @map("cancelled")

  @@map("deposit_status")
}

enum ActorType {
  CONSUMER          @map("consumer")
  DISTRIBUTOR_USER  @map("distributor_user")
  DRIVER            @map("driver")
  SUPPORT           @map("support")
  OPS               @map("ops")
  SYSTEM            @map("system")

  @@map("actor_type")
}

enum ConsumerRole {
  CONSUMER          @map("consumer")
  DISTRIBUTOR_ADMIN @map("distributor_admin")
  DRIVER            @map("driver")
  SUPPORT           @map("support")
  OPS               @map("ops")

  @@map("consumer_role")
}

enum SourceApp {
  CONSUMER_WEB     @map("consumer_web")
  DISTRIBUTOR_WEB  @map("distributor_web")
  DRIVER_WEB       @map("driver_web")
  OPS_CONSOLE      @map("ops_console")
  BACKEND          @map("backend")

  @@map("source_app")
}

enum AuditEventType {
  ORDER_CREATED
  ORDER_PRICING_FINALIZED
  ORDER_CONFIRMED
  ORDER_CANCELLED
  ORDER_RECEIVED_BY_DISTRIBUTOR
  ORDER_ACCEPTED_BY_DISTRIBUTOR
  ORDER_REJECTED_BY_DISTRIBUTOR
  ORDER_DRIVER_ASSIGNED
  DISPATCH_CHECKLIST_COMPLETED
  ORDER_DISPATCHED
  OTP_GENERATED
  OTP_SENT
  OTP_VALIDATION_ATTEMPTED
  OTP_OVERRIDE
  ORDER_DELIVERED
  BOTTLE_EXCHANGE_RECORDED
  EMPTY_NOT_COLLECTED
  REDELIVERY_REQUIRED
  REDELIVERY_SCHEDULED
  PAYMENT_CREATED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  PAYMENT_EXPIRED
  DEPOSIT_HELD
  DEPOSIT_REFUND_INITIATED
  DEPOSIT_REFUNDED
  DAILY_RECONCILIATION_CLOSED
  DEPOSIT_BOTTLES_LOANED
  DEPOSIT_BOTTLES_RETURNED
  DEPOSIT_BOTTLES_WRITTEN_OFF
  DEPOSIT_PROGRAM_ENABLED
  DEPOSIT_PROGRAM_DISABLED

  @@map("audit_event_type")
}

enum IdempotencyStatus {
  PENDING    @map("pending")
  PROCESSED  @map("processed")
  FAILED     @map("failed")

  @@map("idempotency_status")
}

enum UserSubscriptionStatus {
  PENDING_PAYMENT  @map("pending_payment")
  ACTIVE           @map("active")
  PAUSED           @map("paused")
  CANCELLED        @map("cancelled")
  COMPLETED        @map("completed")

  @@map("user_subscription_status")
}

enum DeliveryDateStatus {
  PENDING    @map("pending")
  DELIVERED  @map("delivered")
  CANCELLED  @map("cancelled")

  @@map("delivery_date_status")
}

enum InventoryItemType {
  SELLABLE_PRODUCT
  RETURNABLE_FULL
  RETURNABLE_EMPTY
  SUPPLY

  @@map("inventory_item_type")
}

/// Tipo de produto do catálogo (caução de vasilhames):
/// WATER (refil/água), BOTTLE (vasilhame retornável), OTHER (demais).
enum ProductKind {
  WATER   @map("water")
  BOTTLE  @map("bottle")
  OTHER   @map("other")

  @@map("product_kind")
}

enum InventoryMovementType {
  INITIAL_LOAD
  ORDER_ACCEPT_OUT
  ORDER_CANCEL_RETURN
  DELIVERY_FAILED_RETURN
  EMPTY_RETURN_IN
  RECONCILIATION_ADJUSTMENT
  MANUAL_CORRECTION
  LOSS_WRITE_OFF
  PURCHASE_IN
  DEPOSIT_LOAN_OUT
  DEPOSIT_RETURN_IN

  @@map("inventory_movement_type")
}

/// Movimentos do saldo de vasilhames caucionados (ConsumerDepositMovement).
/// O saldo materializado (ConsumerDepositBalance) é a soma destes deltas.
enum DepositMovementType {
  LOAN_OUT          @map("loan_out")
  RETURN_IN         @map("return_in")
  MANUAL_ADJUSTMENT @map("manual_adjustment")
  WRITE_OFF         @map("write_off")

  @@map("deposit_movement_type")
}

enum InventoryReferenceType {
  ORDER
  RECONCILIATION_SESSION
  INITIAL_LOAD
  MANUAL_ADJUSTMENT
  PURCHASE
  SYSTEM

  @@map("inventory_reference_type")
}

enum InventoryReconciliationStatus {
  OPEN
  CLOSED

  @@map("inventory_reconciliation_status")
}

// ─── Models (19 tabelas — seção 2.1) ───────────────────────────

model Consumer {
  id                       String       @id @default(uuid()) @db.Uuid
  name                     String
  email                    String       @unique
  phone                    String?
  // Documento (CPF/CNPJ) normalizado — somente dígitos. Usado para busca/vinculação
  // ao programa de caução. É mutável; o vínculo persiste consumer_id (FK) + snapshot.
  document                 String?      @unique
  password_hash            String
  role                     ConsumerRole @default(CONSUMER)
  is_b2b                   Boolean      @default(false)
  distributor_id           String?      @db.Uuid
  auto_assign_distributor  Boolean      @default(true)
  preferred_distributor_id String?      @db.Uuid
  created_at               DateTime     @default(now())
  updated_at               DateTime     @updatedAt

  distributor            Distributor?       @relation("DistributorUsers", fields: [distributor_id], references: [id])
  preferred_distributor  Distributor?       @relation("ConsumerPreferredDistributor", fields: [preferred_distributor_id], references: [id])
  addresses              Address[]
  orders                 Order[]            @relation("ConsumerOrders")
  push_tokens            ConsumerPushToken[]
  deposits               Deposit[]
  user_subscriptions     UserSubscription[]
  deposit_programs       ConsumerDepositProgram[]
  deposit_balances       ConsumerDepositBalance[]
  deposit_movements      ConsumerDepositMovement[]

  @@map("01_mst_consumers")
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  consumer_id  String   @db.Uuid
  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zip_code     String
  zone_id      String?  @db.Uuid
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  consumer            Consumer           @relation(fields: [consumer_id], references: [id])
  zone                Zone?              @relation(fields: [zone_id], references: [id])
  orders              Order[]
  user_subscriptions  UserSubscription[]

  @@map("02_mst_addresses")
}

model Distributor {
  id                       String   @id @default(uuid()) @db.Uuid
  name                     String
  cnpj                     String   @unique
  phone                    String
  email                    String
  acceptance_sla_seconds   Int      @default(180)
  is_active                Boolean  @default(true)
  allows_consumer_choice   Boolean  @default(false)
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  users           Consumer[]               @relation("DistributorUsers")
  preferred_by    Consumer[]               @relation("ConsumerPreferredDistributor")
  zones           Zone[]
  orders          Order[]
  reconciliations Reconciliation[]
  schedules       DistributorSchedule[]
  blocked_dates   DistributorBlockedDate[]
  time_slots                     TimeSlot[]
  subscription_plan_distributors SubscriptionPlanDistributor[]
  user_subscriptions             UserSubscription[]
  inventory_balances             DistributorInventoryBalance[]
  inventory_movements            InventoryMovement[]
  inventory_reconciliation_sessions InventoryReconciliationSession[]
  payment_settings               DistributorPaymentSettings?
  deposit_programs               ConsumerDepositProgram[]
  deposit_balances               ConsumerDepositBalance[]
  deposit_movements              ConsumerDepositMovement[]

  @@map("03_mst_distributors")
}

/// Configuração de pagamento por distribuidora: métodos aceitos + credenciais
/// do gateway (Mercado Pago) dela. access token e webhook secret são guardados
/// CRIPTOGRAFADOS (AES-256-GCM). 1:1 com Distributor.
model DistributorPaymentSettings {
  id             String @id @default(uuid()) @db.Uuid
  distributor_id String @unique @db.Uuid

  // Métodos aceitos (capacidades públicas)
  accepts_pix_online       Boolean @default(false)
  accepts_credit_online    Boolean @default(false)
  accepts_cash_on_delivery Boolean @default(true)
  accepts_card_on_delivery Boolean @default(false)

  // Credenciais do gateway (sensíveis)
  provider              String  @default("mercadopago")
  mp_access_token_enc   String?
  mp_webhook_secret_enc String?
  mp_public_key         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  distributor Distributor @relation(fields: [distributor_id], references: [id], onDelete: Cascade)

  @@map("34_cfg_distributor_payment_settings")
}

model Zone {
  id              String   @id @default(uuid()) @db.Uuid
  distributor_id  String   @db.Uuid
  name            String
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  distributor     Distributor        @relation(fields: [distributor_id], references: [id])
  coverage        ZoneCoverage[]
  addresses       Address[]
  orders          Order[]

  @@map("04_mst_zones")
}

model ZoneCoverage {
  id           String   @id @default(uuid()) @db.Uuid
  zone_id      String   @db.Uuid
  neighborhood String?
  zip_code     String?
  created_at   DateTime @default(now())

  zone Zone @relation(fields: [zone_id], references: [id])

  @@map("05_mst_zone_coverage")
}

model Product {
  id            String      @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  image_url     String?
  price_cents   Int
  // DEPRECATED: era a "caução financeira" por produto. Não usado na caução de vasilhames
  // (o vasilhame é um Product próprio kind=BOTTLE com seu price_cents). Removido na limpeza final.
  deposit_cents Int         @default(0)
  // Tipo do produto: WATER (refil), BOTTLE (vasilhame), OTHER.
  kind          ProductKind @default(OTHER)
  // Vasilhame vinculado a uma água (kind=WATER → BOTTLE). Usado p/ adicionar o
  // vasilhame certo automaticamente quando faltam vazios. 1 água → 1 vasilhame.
  bottle_product_id String? @db.Uuid
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  bottle_product      Product?           @relation("WaterBottle", fields: [bottle_product_id], references: [id])
  water_products      Product[]          @relation("WaterBottle")
  categories          Category[]
  inventory_items     InventoryItem[]
  order_items         OrderItem[]
  subscription_plans  SubscriptionPlan[]

  @@index([is_active])
  @@index([bottle_product_id])
  @@map("06_mst_products")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  value      String    @unique
  sort_order Int       @default(0)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  products Product[]

  @@map("07_mst_categories")
}

model InventoryItem {
  id                  String            @id @default(uuid()) @db.Uuid
  code                String            @unique
  name                String
  type                InventoryItemType
  product_id          String?           @db.Uuid
  unit_label          String
  low_stock_threshold Int?
  is_active           Boolean           @default(true)
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  product            Product?                     @relation(fields: [product_id], references: [id])
  distributor_balances DistributorInventoryBalance[]
  inventory_movements InventoryMovement[]
  inventory_reconciliation_items InventoryReconciliationItem[]
  deposit_balances   ConsumerDepositBalance[]
  deposit_movements  ConsumerDepositMovement[]

  @@index([product_id])
  @@map("29_mst_inventory_items")
}

model DistributorInventoryBalance {
  id                String   @id @default(uuid()) @db.Uuid
  distributor_id    String   @db.Uuid
  inventory_item_id String   @db.Uuid
  quantity_on_hand  Int      @default(0)
  last_movement_at  DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  distributor    Distributor   @relation(fields: [distributor_id], references: [id])
  inventory_item InventoryItem @relation(fields: [inventory_item_id], references: [id])

  @@unique([distributor_id, inventory_item_id])
  @@index([distributor_id])
  @@index([inventory_item_id])
  @@map("30_trn_distributor_inventory_balances")
}

model InventoryMovement {
  id                String                 @id @default(uuid()) @db.Uuid
  distributor_id    String                 @db.Uuid
  inventory_item_id String                 @db.Uuid
  quantity_delta    Int
  movement_type     InventoryMovementType
  actor_type        ActorType
  actor_id          String
  source_app        SourceApp
  reference_type    InventoryReferenceType?
  reference_id      String?
  metadata          Json                   @default("{}")
  occurred_at       DateTime               @default(now())

  distributor    Distributor   @relation(fields: [distributor_id], references: [id])
  inventory_item InventoryItem @relation(fields: [inventory_item_id], references: [id])
  reconciliation_item InventoryReconciliationItem? @relation("InventoryReconciliationAdjustment")

  @@unique([distributor_id, inventory_item_id, movement_type, reference_type, reference_id])
  @@index([distributor_id, occurred_at])
  @@index([distributor_id, inventory_item_id, occurred_at])
  @@index([distributor_id, movement_type, occurred_at])
  @@index([movement_type, occurred_at])
  @@index([occurred_at])
  @@index([occurred_at, id])
  @@index([inventory_item_id, occurred_at])
  @@index([inventory_item_id, movement_type, occurred_at])
  @@index([reference_type, reference_id])
  @@map("31_trn_inventory_movements")
}

model InventoryReconciliationSession {
  id             String                        @id @default(uuid()) @db.Uuid
  distributor_id String                        @db.Uuid
  status         InventoryReconciliationStatus @default(OPEN)
  opened_by      String
  closed_by      String?
  justification  String?
  opened_at      DateTime                      @default(now())
  closed_at      DateTime?
  created_at     DateTime                      @default(now())
  updated_at     DateTime                      @updatedAt

  distributor Distributor                  @relation(fields: [distributor_id], references: [id])
  items       InventoryReconciliationItem[]

  @@index([distributor_id, status])
  @@index([status, opened_at])
  @@index([distributor_id, opened_at])
  @@map("32_trn_inventory_reconciliation_sessions")
}

model InventoryReconciliationItem {
  id                     String   @id @default(uuid()) @db.Uuid
  session_id             String   @db.Uuid
  inventory_item_id      String   @db.Uuid
  snapshot_quantity      Int
  counted_quantity       Int?
  delta                  Int?
  adjustment_movement_id String?  @unique @db.Uuid
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  session             InventoryReconciliationSession @relation(fields: [session_id], references: [id])
  inventory_item      InventoryItem                  @relation(fields: [inventory_item_id], references: [id])
  adjustment_movement InventoryMovement?             @relation("InventoryReconciliationAdjustment", fields: [adjustment_movement_id], references: [id])

  @@unique([session_id, inventory_item_id])
  @@index([inventory_item_id])
  @@map("33_trn_inventory_reconciliation_items")
}

model ConsumerPushToken {
  id          String   @id @default(uuid()) @db.Uuid
  consumer_id String   @db.Uuid
  endpoint    String
  p256dh      String
  auth_key    String
  created_at  DateTime @default(now())

  consumer Consumer @relation(fields: [consumer_id], references: [id])

  @@map("08_sec_consumer_push_tokens")
}

model Order {
  id                         String         @id @default(uuid()) @db.Uuid
  consumer_id                String         @db.Uuid
  address_id                 String         @db.Uuid
  distributor_id             String         @db.Uuid
  zone_id                    String         @db.Uuid
  driver_id                  String?        @db.Uuid
  status                     OrderStatus    @default(CREATED)
  delivery_date              DateTime       @db.Date
  delivery_window            DeliveryWindow
  time_slot_id               String?        @db.Uuid
  preferred_time_start       Int?
  preferred_time_end         Int?
  // Snapshot imutável do horário no momento da criação do pedido.
  // Garante que alterações futuras em TimeSlot não afetem o histórico.
  scheduled_time_label         String?
  scheduled_time_start_hour    Int?
  scheduled_time_start_minute  Int?
  scheduled_time_end_hour      Int?
  scheduled_time_end_minute    Int?
  subtotal_cents             Int            @default(0)
  // DEPRECATED (caução financeira) — mantidos temporariamente p/ compat; sempre 0 na
  // nova lógica de caução de vasilhames. Removidos na migração destrutiva final.
  deposit_cents              Int            @default(0)
  deposit_amount_cents       Int            @default(0)
  total_cents                Int            @default(0)
  // Settlement de vasilhames (caução de vasilhames):
  // faltantes = max(0, bottles_full_ordered - empty_bottles_provided) = bottles_sold + bottles_loaned
  bottles_full_ordered       Int            @default(0)
  empty_bottles_provided     Int            @default(0)
  bottles_sold               Int            @default(0)
  bottles_loaned             Int            @default(0)
  qty_20l_sent               Int?
  qty_20l_returned           Int?
  rating                     Int?
  rating_comment             String?
  nps_score                  Int?
  nps_comment                String?
  collected_empty_qty        Int            @default(0)
  returned_empty_qty         Int?
  bottle_condition           String?
  empty_not_collected_reason String?
  empty_not_collected_notes  String?
  payment_status             String?
  cancellation_reason        String?
  accepted_at                DateTime?
  dispatched_at              DateTime?
  delivered_at               DateTime?
  created_at                 DateTime       @default(now())
  updated_at                 DateTime       @updatedAt

  consumer    Consumer      @relation("ConsumerOrders", fields: [consumer_id], references: [id])
  address     Address       @relation(fields: [address_id], references: [id])
  distributor Distributor   @relation(fields: [distributor_id], references: [id])
  zone        Zone          @relation(fields: [zone_id], references: [id])
  time_slot   TimeSlot?     @relation(fields: [time_slot_id], references: [id])
  items       OrderItem[]
  payments    Payment[]
  deposits    Deposit[]
  deposit_movements ConsumerDepositMovement[]
  otps        OrderOtp[]
  audit_events AuditEvent[]
  subscription_delivery_date  SubscriptionDeliveryDate?

  @@index([distributor_id, status, created_at], map: "09_trn_orders_distributor_status_created_idx")
  @@index([distributor_id, delivery_date, status], map: "09_trn_orders_distributor_delivery_status_idx")
  @@index([distributor_id, driver_id, status], map: "09_trn_orders_distributor_driver_status_idx")
  @@index([consumer_id, created_at], map: "09_trn_orders_consumer_created_idx")
  @@map("09_trn_orders")
}

model OrderItem {
  id               String   @id @default(uuid()) @db.Uuid
  order_id         String   @db.Uuid
  product_id       String   @db.Uuid
  product_name     String
  unit_price_cents Int
  quantity         Int
  subtotal_cents   Int
  created_at       DateTime @default(now())

  order   Order   @relation(fields: [order_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@index([order_id], map: "10_trn_order_items_order_idx")
  @@map("10_trn_order_items")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  order_id             String?       @db.Uuid
  user_subscription_id String?       @db.Uuid
  kind                 PaymentKind   @default(ORDER)
  status               PaymentStatus @default(CREATED)
  amount_cents         Int           @default(0)
  payment_method       String?
  cash_change_for_cents Int?
  provider             String?
  provider_payment_ref String?
  external_id          String?       @unique
  idempotency_key      String?
  paid_at              DateTime?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  order             Order?             @relation(fields: [order_id], references: [id])
  user_subscription UserSubscription?  @relation(fields: [user_subscription_id], references: [id])
  transactions      PaymentTransaction[]

  @@index([order_id, provider, created_at], map: "idx_payments_order_provider_created")
  @@index([user_subscription_id, provider, created_at], map: "idx_payments_sub_provider_created")
  @@index([provider, provider_payment_ref], map: "idx_payments_provider_payment_ref")
  @@index([idempotency_key], map: "idx_payments_idempotency_key")
  @@map("13_trn_payments")
}

model PaymentWebhookEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  provider           String
  provider_event_ref String
  event_type         String
  distributor_id     String?   @db.Uuid
  payload            Json      @default("{}")
  raw_headers        Json?
  signature_valid    Boolean   @default(false)
  processed_at       DateTime?
  processing_error   String?
  retry_count        Int       @default(0)
  created_at         DateTime  @default(now())

  @@unique([provider, provider_event_ref])
  @@map("14_cfg_payment_webhook_events")
}

model Deposit {
  id          String       @id @default(uuid()) @db.Uuid
  order_id    String       @db.Uuid
  consumer_id String       @db.Uuid
  amount_cents Int
  status      DepositStatus @default(HELD)
  refunded_at DateTime?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  order    Order    @relation(fields: [order_id], references: [id])
  consumer Consumer @relation(fields: [consumer_id], references: [id])

  @@index([order_id], map: "15_trn_deposits_order_idx")
  @@index([consumer_id, status], map: "15_trn_deposits_consumer_status_idx")
  @@map("15_trn_deposits")
}

/// Programa de caução de vasilhames — habilitação por par Distribuidora×Consumidor.
/// Fonte da verdade da exceção operacional. Vínculo via consumer_id (FK estável);
/// consumer_document_snapshot guarda o CPF/CNPJ usado na concessão (dado, não FK).
model ConsumerDepositProgram {
  id                         String   @id @default(uuid()) @db.Uuid
  distributor_id             String   @db.Uuid
  consumer_id                String   @db.Uuid
  consumer_document_snapshot String
  is_enabled                 Boolean  @default(true)
  // 0 = bloqueado (sem caução). NUNCA significa "ilimitado".
  max_bottles                Int      @default(0)
  notes                      String?
  enabled_by                 String
  enabled_at                 DateTime @default(now())
  disabled_by                String?
  disabled_at                DateTime?
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  distributor Distributor @relation(fields: [distributor_id], references: [id])
  consumer    Consumer    @relation(fields: [consumer_id], references: [id])

  @@unique([distributor_id, consumer_id])
  @@index([consumer_id, is_enabled], map: "35_cfg_consumer_deposit_programs_consumer_idx")
  @@index([distributor_id, is_enabled], map: "35_cfg_consumer_deposit_programs_distributor_idx")
  @@map("35_cfg_consumer_deposit_programs")
}

/// Saldo materializado de vasilhames caucionados por (distribuidora, consumidor, item).
/// É a soma dos ConsumerDepositMovement. bottles_on_loan nunca negativo.
model ConsumerDepositBalance {
  id                String    @id @default(uuid()) @db.Uuid
  distributor_id    String    @db.Uuid
  consumer_id       String    @db.Uuid
  inventory_item_id String    @db.Uuid
  bottles_on_loan   Int       @default(0)
  last_movement_at  DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  distributor    Distributor   @relation(fields: [distributor_id], references: [id])
  consumer       Consumer      @relation(fields: [consumer_id], references: [id])
  inventory_item InventoryItem @relation(fields: [inventory_item_id], references: [id])

  @@unique([distributor_id, consumer_id, inventory_item_id])
  @@index([consumer_id], map: "36_trn_consumer_deposit_balances_consumer_idx")
  @@index([distributor_id], map: "36_trn_consumer_deposit_balances_distributor_idx")
  @@map("36_trn_consumer_deposit_balances")
}

/// Histórico (event-sourcing) das movimentações de caução de vasilhames.
model ConsumerDepositMovement {
  id                String              @id @default(uuid()) @db.Uuid
  distributor_id    String              @db.Uuid
  consumer_id       String              @db.Uuid
  inventory_item_id String              @db.Uuid
  bottles_delta     Int
  movement_type     DepositMovementType
  actor_type        ActorType
  actor_id          String
  source_app        SourceApp
  order_id          String?             @db.Uuid
  notes             String?
  occurred_at       DateTime            @default(now())

  distributor    Distributor   @relation(fields: [distributor_id], references: [id])
  consumer       Consumer      @relation(fields: [consumer_id], references: [id])
  inventory_item InventoryItem @relation(fields: [inventory_item_id], references: [id])
  order          Order?        @relation(fields: [order_id], references: [id])

  @@index([distributor_id, consumer_id, occurred_at], map: "37_log_consumer_deposit_movements_dist_consumer_idx")
  @@index([consumer_id, occurred_at], map: "37_log_consumer_deposit_movements_consumer_idx")
  @@index([order_id], map: "37_log_consumer_deposit_movements_order_idx")
  @@map("37_log_consumer_deposit_movements")
}

model OrderOtp {
  id         String    @id @default(uuid()) @db.Uuid
  order_id   String    @db.Uuid
  otp_hash   String
  status     OtpStatus @default(ACTIVE)
  attempts   Int       @default(0)
  expires_at DateTime
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  order Order @relation(fields: [order_id], references: [id])

  @@map("16_sec_order_otps")
}

model Reconciliation {
  id                  String   @id @default(uuid()) @db.Uuid
  distributor_id      String   @db.Uuid
  reconciliation_date DateTime @db.Date
  full_out            Int
  empty_returned      Int
  delta               Int
  justification       String?
  closed_by           String
  created_at          DateTime @default(now())

  distributor Distributor @relation(fields: [distributor_id], references: [id])

  @@index([distributor_id, reconciliation_date, id])
  @@index([reconciliation_date, id])
  @@map("17_trn_reconciliations")
}

model AuditEvent {
  id          String         @id @default(uuid()) @db.Uuid
  event_type  AuditEventType
  actor_type  ActorType
  actor_id    String
  order_id    String?        @db.Uuid
  source_app  SourceApp
  payload     Json           @default("{}")
  occurred_at DateTime       @default(now())

  order Order? @relation(fields: [order_id], references: [id])

  @@index([order_id, occurred_at], map: "18_aud_audit_events_order_occurred_idx")
  @@map("18_aud_audit_events")
}

// ─── Idempotency Keys (deduplicação de webhooks) ──────────────

model IdempotencyKey {
  id           String            @id @default(uuid()) @db.Uuid
  key          String            @unique
  status       IdempotencyStatus @default(PENDING)
  locked_at    DateTime?
  processed_at DateTime?
  created_at   DateTime          @default(now())

  @@index([status, locked_at])
  @@map("20_cfg_idempotency_keys")
}

// ─── Payment Transactions (trilha de interações com provedor) ──

model PaymentTransaction {
  id               String   @id @default(uuid()) @db.Uuid
  payment_id       String   @db.Uuid
  action           String
  provider_status  String
  provider_response Json    @default("{}")
  idempotency_key  String?
  created_at       DateTime @default(now())

  payment Payment @relation(fields: [payment_id], references: [id])

  @@index([payment_id, created_at])
  @@map("21_trn_payment_transactions")
}

// ─── Banners promocionais configuráveis (admin) ────────────────

enum BannerType {
  CAROUSEL @map("carousel")
  FEATURED @map("featured")

  @@map("banner_type")
}

model Banner {
  id               String     @id @default(uuid()) @db.Uuid
  type             BannerType
  title            String
  subtitle         String?
  tag              String?
  highlight        String?
  cta_text         String?
  cta_url          String?
  bg_color         String?
  bg_gradient_from String?
  bg_gradient_to   String?
  bg_image_url     String?
  text_color       String?
  image_url        String?
  is_active        Boolean    @default(true)
  sort_order       Int        @default(0)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  @@index([is_active])
  @@map("19_cfg_banners")
}

model DistributorSchedule {
  id              String   @id @default(uuid()) @db.Uuid
  distributor_id  String   @db.Uuid
  weekday         Int
  is_active       Boolean  @default(true)
  lead_time_hours Int      @default(2)
  created_at      DateTime @default(now())

  distributor Distributor @relation(fields: [distributor_id], references: [id])

  @@unique([distributor_id, weekday])
  @@map("22_cfg_distributor_schedule")
}

model DistributorBlockedDate {
  id             String   @id @default(uuid()) @db.Uuid
  distributor_id String   @db.Uuid
  blocked_date   DateTime @db.Date
  reason         String?
  created_at     DateTime @default(now())

  distributor Distributor @relation(fields: [distributor_id], references: [id])

  @@unique([distributor_id, blocked_date])
  @@map("23_cfg_distributor_blocked_dates")
}

model TimeSlot {
  id             String         @id @default(uuid()) @db.Uuid
  distributor_id String         @db.Uuid
  label          String
  start_hour     Int
  start_minute   Int            @default(0)
  end_hour       Int
  end_minute     Int            @default(0)
  window         DeliveryWindow
  is_active      Boolean        @default(true)
  sort_order     Int            @default(0)
  created_at     DateTime       @default(now())

  distributor                 Distributor               @relation(fields: [distributor_id], references: [id])
  orders                      Order[]
  subscription_delivery_dates SubscriptionDeliveryDate[]

  @@map("24_cfg_time_slots")
}

// ─── Subscription Plans (novo modelo pré-definido pela ops) ────

model SubscriptionPlan {
  id                             String   @id @default(uuid()) @db.Uuid
  name                           String
  description                    String?
  product_id                     String   @db.Uuid
  quantity                       Int
  discount_percentage            Int      @default(0)
  unit_price_with_discount_cents Int
  valid_from                     DateTime @db.Date
  valid_until                    DateTime @db.Date
  is_active                      Boolean  @default(true)
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt

  product            Product                      @relation(fields: [product_id], references: [id])
  distributors       SubscriptionPlanDistributor[]
  user_subscriptions UserSubscription[]

  @@map("25_cfg_subscription_plans")
}

model SubscriptionPlanDistributor {
  plan_id        String @db.Uuid
  distributor_id String @db.Uuid

  plan        SubscriptionPlan @relation(fields: [plan_id], references: [id])
  distributor Distributor      @relation(fields: [distributor_id], references: [id])

  @@id([plan_id, distributor_id])
  @@map("26_piv_subscription_plan_distributors")
}

model UserSubscription {
  id                               String                 @id @default(uuid()) @db.Uuid
  consumer_id                      String                 @db.Uuid
  plan_id                          String                 @db.Uuid
  distributor_id                   String                 @db.Uuid
  address_id                       String                 @db.Uuid
  total_quantity                   Int
  remaining_quantity               Int
  start_date                       DateTime               @db.Date
  end_date                         DateTime               @db.Date
  status                           UserSubscriptionStatus @default(PENDING_PAYMENT)
  low_balance_notification_sent_at DateTime?
  created_at                       DateTime               @default(now())
  updated_at                       DateTime               @updatedAt

  consumer       Consumer                   @relation(fields: [consumer_id], references: [id])
  plan           SubscriptionPlan           @relation(fields: [plan_id], references: [id])
  distributor    Distributor                @relation(fields: [distributor_id], references: [id])
  address        Address                    @relation(fields: [address_id], references: [id])
  delivery_dates SubscriptionDeliveryDate[]
  payments       Payment[]

  @@map("27_trn_user_subscriptions")
}

model SubscriptionDeliveryDate {
  id                         String             @id @default(uuid()) @db.Uuid
  user_subscription_id       String             @db.Uuid
  delivery_date              DateTime           @db.Date
  time_slot_id               String             @db.Uuid
  quantity_for_this_delivery Int
  status                     DeliveryDateStatus @default(PENDING)
  order_id                   String?            @db.Uuid @unique
  created_at                 DateTime           @default(now())
  updated_at                 DateTime           @default(now()) @updatedAt

  user_subscription UserSubscription @relation(fields: [user_subscription_id], references: [id])
  time_slot         TimeSlot         @relation(fields: [time_slot_id], references: [id])
  order             Order?           @relation(fields: [order_id], references: [id])

  @@map("28_trn_subscription_delivery_dates")
}
