{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020"],
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@api/*": ["../apps/api/src/*"],
      "@xua/shared": ["../packages/shared/src/index.ts"],
      "@xua/shared/*": ["../packages/shared/src/*"],
      "@tests/*": ["./*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
