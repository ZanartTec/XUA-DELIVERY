# ─────────────────────────────────────────────────────────────────────
# XUA Delivery API — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite valores reais.
# ─────────────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# ── Banco de dados (PostgreSQL via Prisma) ───────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/xua_delivery

# ── Redis ────────────────────────────────────────────────────────────
# A infraestrutura separa Redis por finalidade:
#   - CACHE_REDIS_URL: cache de catálogo/banners, rate limiting, blacklist
#     de JWT, tokens de troca de senha, exibição de OTP. Perda de dados é
#     tolerável (cache é opcional — a API degrada, não cai).
#   - QUEUE_REDIS_URL: BullMQ (filas internal-jobs, payment-webhooks,
#     payments, payment-refunds, subscription-expiration). Perda de dados
#     NÃO é tolerável (jobs pendentes).
# REDIS_URL é o fallback legado: se a variável dedicada não estiver
# definida, a finalidade correspondente usa REDIS_URL. Para migração sem
# downtime, mantenha REDIS_URL até as duas dedicadas estarem em produção.
# Local: o docker-compose.yml sobe redis-cache (6379, volatile-lru) e
# redis-queue (6380, noeviction + AOF) — use as duas dedicadas abaixo.
CACHE_REDIS_URL=redis://localhost:6379
QUEUE_REDIS_URL=redis://localhost:6380
# Fallback legado (setups com Redis único):
# REDIS_URL=redis://localhost:6379

# Prefixo de chaves Redis (default: xua:<NODE_ENV>)
# REDIS_KEY_PREFIX=xua:development
# Prefixo das filas BullMQ (default: <REDIS_KEY_PREFIX>:queue)
# QUEUE_PREFIX=xua:development:queue

# ── Autenticação e segredos ──────────────────────────────────────────
# Segredo de assinatura dos JWTs (use um valor longo e aleatório)
JWT_SECRET=change-me
# HMAC-SHA256 dos tokens de reset de senha
PASSWORD_RESET_SECRET=change-me
# HMAC-SHA256 dos códigos OTP de entrega
OTP_SECRET=change-me
# Hash bcrypt dummy para mitigar timing attacks no login (obrigatório)
DUMMY_HASH=$2b$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chave mestra AES-256-GCM para credenciais de gateway (32 bytes, base64)
ENCRYPTION_MASTER_KEY=change-me
# Segredo dos endpoints internos (/api/internal/jobs/*)
INTERNAL_SECRET=change-me

# ── Origens permitidas (CORS) ────────────────────────────────────────
APP_ORIGIN=http://localhost:3000
# Lista adicional separada por vírgula
# APP_ALLOWED_ORIGINS=https://app.xua.example,https://ops.xua.example
# URL externa injetada pelo Render (não definir localmente)
# RENDER_EXTERNAL_URL=

# ── E-mail (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=XUA Delivery <no-reply@xua.example>

# ── Web Push (VAPID) ─────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:contato@xua.example

# ── Pagamentos ───────────────────────────────────────────────────────
PAYMENT_PROVIDER=mercadopago
# Minutos até expirar uma cobrança pendente (default no código: 15)
# PAYMENT_EXPIRATION_MINUTES=15
# HMAC do contexto assinado dos webhooks (fallback: INTERNAL_SECRET)
# PAYMENT_WEBHOOK_CONTEXT_SECRET=change-me

# ── Mercado Pago ─────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS=300
# MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
# MERCADOPAGO_REQUEST_TIMEOUT_MS=10000
# MERCADOPAGO_STATEMENT_DESCRIPTOR=XUA DELIVERY
# MERCADOPAGO_NOTIFICATION_URL=https://api.xua.example/api/payments/webhook
# MERCADOPAGO_NOTIFICATION_SOURCE=webhooks
# MERCADOPAGO_BACK_URL_SUCCESS=https://app.xua.example/checkout/confirmation
# MERCADOPAGO_BACK_URL_FAILURE=https://app.xua.example/checkout/confirmation
# MERCADOPAGO_BACK_URL_PENDING=https://app.xua.example/checkout/confirmation

# ── Rate limits de pagamento (opcionais — defaults no código) ────────
# PAYMENT_CHARGE_RATE_LIMIT_WINDOW_SECONDS=60
# PAYMENT_CHARGE_RATE_LIMIT_MAX=12
# PAYMENT_STATUS_RATE_LIMIT_WINDOW_SECONDS=60
# PAYMENT_STATUS_RATE_LIMIT_MAX=120
# PAYMENT_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
# PAYMENT_WEBHOOK_RATE_LIMIT_MAX=600

# ── Worker (concorrência por fila — default: 1) ──────────────────────
# INTERNAL_JOBS_WORKER_CONCURRENCY=1
# PAYMENT_WEBHOOK_WORKER_CONCURRENCY=1
# PAYMENTS_WORKER_CONCURRENCY=1
# PAYMENT_REFUNDS_WORKER_CONCURRENCY=1
# SUBSCRIPTION_EXPIRATION_WORKER_CONCURRENCY=1
