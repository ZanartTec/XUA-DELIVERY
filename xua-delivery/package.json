{
  "name": "xua-delivery",
  "version": "1.0.0-beta.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:api": "npm run dev -w @xua/api",
    "dev:api:stable": "node --env-file=apps/api/.env --import tsx apps/api/src/server/index.ts",
    "dev:worker:stable": "node --env-file=apps/api/.env --import tsx apps/api/src/worker/index.ts",
    "dev:web": "npm run dev -w @xua/web",
    "build:api": "npx prisma generate",
    "build:web": "npm run build -w @xua/web",
    "start:api": "npm run start -w @xua/api",
    "start:web": "npm run start -w @xua/web",
    "lint": "npm run lint -w @xua/web",
    "typecheck:api": "npm run typecheck -w @xua/api",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:e2e": "npm run test:e2e -w @xua/web",
    "payments:webhook:reprocess": "tsx scripts/reprocess-payment-webhook.ts",
    "enums:check": "tsx scripts/check-enums.ts",
    "seed:caucao": "tsx prisma/seed-caucao.ts",
    "postinstall": "prisma generate",
    "prepare": "cd .. && husky xua-delivery/.husky || true",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "commitlint": "commitlint --edit",
    "shared:check": "tsc -p packages/shared/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xua/shared": "*",
    "prisma": "^7.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "husky": "^9.1.7",
    "semantic-release": "^24.2.9",
    "tsx": "^4.19.4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
